<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>NoteBloom — Your personal workspace</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');

:root {
  --bg:#f5f4f0;
  --surface:#fff;
  --ink:#393a35;
  --muted:#909087;
  --line:#e9e8e1;
  --accent:#81917b;
}
*{box-sizing:border-box}
body{
  margin:0;background:var(--bg);color:var(--ink);
  font-family:'DM Sans',sans-serif;transition:.2s;
}
body.dark{
  --surface:#292a29;--ink:#eeeee9;--muted:#aaa99f;
  --line:#41423f;
}
button,input,textarea,select{font:inherit}
button{cursor:pointer;color:inherit}
.app{max-width:1450px;margin:auto;padding:28px 5%}
header{display:flex;align-items:center;justify-content:space-between;gap:15px}
.logo{font:700 29px 'Playfair Display',serif}
.logo span{color:var(--accent)}
.header-actions{display:flex;gap:9px;align-items:center}
.small-btn,.nav-btn{
  border:1px solid var(--line);background:var(--surface);
  padding:10px 14px;border-radius:12px;font-size:13px;
}
.hero{margin:48px 0 25px}
.hero h1{font:600 clamp(30px,4vw,43px) 'Playfair Display',serif;margin:0 0 8px}
.hero p{color:var(--muted);font-size:14px}
.stats{display:flex;gap:12px;flex-wrap:wrap;margin:25px 0}
.stat{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:15px 20px;min-width:125px}
.stat strong{display:block;font-size:23px}
.stat small{color:var(--muted)}
.toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin:30px 0 18px}
.tabs,.actions{display:flex;gap:8px;flex-wrap:wrap}
.tab{border:1px solid var(--line);background:var(--surface);border-radius:22px;padding:9px 15px;font-size:12px}
.tab.active{background:var(--ink);color:var(--surface);border-color:var(--ink)}
.primary{border:0;background:#81917b;color:white;border-radius:22px;padding:11px 18px;font-weight:600}
.search,.field input,.field textarea,.field select{
  border:1px solid var(--line);background:var(--surface);color:var(--ink);
  border-radius:10px;padding:11px;outline:none;width:100%;
}
.search{width:190px;border-radius:22px}
.notes-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:17px}
.note{
  border-radius:15px;padding:18px;min-height:220px;
  display:flex;flex-direction:column;border:1px solid rgba(0,0,0,.035);
  box-shadow:0 4px 14px rgba(0,0,0,.035);transition:.2s;
}
.note:hover{transform:translateY(-3px)}
.yellow{background:#fff3d8;color:#424139}
.pink{background:#f8e7e8;color:#48403f}
.green{background:#e6eee3;color:#39443a}
.blue{background:#e7edf5;color:#3c4551}
.purple{background:#eee7f4;color:#46404e}
.note-top,.note-footer{display:flex;justify-content:space-between;align-items:center;gap:8px}
.note-top{margin-bottom:13px}
.note-date,.note-footer{font-size:11px;color:#77766f}
.note h3{font-size:17px;margin:0 0 8px;overflow-wrap:anywhere}
.note p{font-size:12px;line-height:1.6;white-space:pre-wrap;overflow-wrap:anywhere}
.note-menu{display:flex;gap:5px}
.icon-btn{border:0;background:transparent;font-size:15px;padding:4px}
.task-list{display:grid;gap:8px;margin:8px 0}
.task{font-size:12px}
.task label{display:flex;gap:7px;align-items:center}
.task input{accent-color:#81917b}
.done{text-decoration:line-through;opacity:.5}
.progress{height:4px;background:rgba(0,0,0,.1);margin:12px 0;border-radius:9px;overflow:hidden}
.progress div{height:100%;background:#81917b}
.note-footer{margin-top:auto;padding-top:12px;flex-wrap:wrap}
.note-tools{display:flex;align-items:center;gap:5px}
.timer-box{background:rgba(255,255,255,.55);padding:6px 8px;border-radius:9px;display:flex;gap:7px;align-items:center}
.timer-box button{border:0;background:none}
.timer-display{font-weight:700;font-size:11px;font-variant-numeric:tabular-nums}
.file-link{display:block;font-size:11px;color:inherit;margin-top:7px;overflow-wrap:anywhere}
.pinned{outline:2px solid #81917b}
.note.small{min-height:155px}
.note.large{grid-column:span 2;min-height:290px}
.notes-grid.widgets{grid-template-columns:repeat(auto-fill,minmax(210px,1fr))}
.dragging{opacity:.4}
.drop-target{outline:2px dashed #81917b}
.empty{text-align:center;grid-column:1/-1;padding:65px;color:var(--muted)}
.empty div{font-size:35px}
.panel{
  display:none;background:var(--surface);border:1px solid var(--line);
  border-radius:16px;padding:20px;margin:20px 0;
}
.panel.show{display:block}
.panel h2{font:600 23px 'Playfair Display',serif}
.modal{position:fixed;inset:0;background:#0006;display:none;align-items:center;justify-content:center;padding:15px;z-index:20}
.modal.show{display:flex}
.modal-content{background:var(--surface);color:var(--ink);width:100%;max-width:490px;max-height:90vh;overflow:auto;padding:25px;border-radius:19px}
.modal-content h2{font:600 24px 'Playfair Display',serif}
.field{margin:14px 0}
.field label{display:block;font-size:11px;color:var(--muted);margin-bottom:7px}
.field textarea{min-height:80px;resize:vertical}
.color-options{display:flex;gap:10px}
.color-choice{height:30px;width:30px;border-radius:50%;border:2px solid white;outline:1px solid var(--line)}
.color-choice.selected{outline:2px solid #81917b}
.subtask-editor{display:flex;gap:6px;margin-bottom:7px}
.subtask-editor input{flex:1}
.subtask-editor button{border:0;background:var(--line);border-radius:8px;padding:0 10px}
.modal-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:20px}
.secondary{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:10px 17px}
.settings-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:18px}
.settings-grid label{font-size:12px;color:var(--muted);display:block;margin-bottom:8px}
.swatches{display:flex;gap:9px;flex-wrap:wrap}
.swatch{width:29px;height:29px;border-radius:50%;border:2px solid white;outline:1px solid var(--line)}
.pomodoro{text-align:center;padding:15px}
.pomo-time{font-size:50px;font-weight:600;font-variant-numeric:tabular-nums;margin:15px}
.pomo-controls{display:flex;justify-content:center;gap:10px;flex-wrap:wrap}
.calendar-head{display:flex;justify-content:space-between;align-items:center}
.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;margin-top:15px}
.calendar-cell{min-height:75px;background:var(--bg);padding:7px;border-radius:8px;font-size:12px}
.calendar-cell.today{outline:2px solid #81917b}
.calendar-cell small{display:block;font-size:9px;color:var(--accent);margin-top:5px;overflow-wrap:anywhere}
.upcoming{display:grid;gap:10px}
.upcoming-item{padding:12px;background:var(--bg);border-radius:9px;font-size:13px}
.muted{color:var(--muted);font-size:12px}
@media(max-width:600px){
 .app{padding:20px 15px}.header-actions .small-btn{padding:8px}
 .hero{margin-top:35px}.toolbar{align-items:stretch}
 .actions{width:100%}.search{flex:1;width:100%}
 .notes-grid{grid-template-columns:1fr}
 .note.large{grid-column:span 1}
 .calendar-cell{min-height:55px;padding:4px}
}
</style>
</head>
<body>
<div class="app">
<header>
 <div class="logo">note<span>bloom.</span></div>
 <div class="header-actions">
  <button class="small-btn" onclick="showPanel('settings')">⚙ Settings</button>
  <button class="small-btn" onclick="toggleDark()">☾</button>
 </div>
</header>

<section class="hero">
 <h1>Your space. Your pace.</h1>
 <p>A little space to plan, focus and get things done.</p>
</section>

<div class="stats">
 <div class="stat"><strong id="noteCount">0</strong><small>Total notes</small></div>
 <div class="stat"><strong id="doneCount">0</strong><small>Completed subtasks</small></div>
 <div class="stat"><strong id="pendingCount">0</strong><small>Pending subtasks</small></div>
 <div class="stat"><strong id="weekCount">0</strong><small>Done this week</small></div>
</div>

<nav class="tabs">
 <button class="tab active" data-view="all">All notes</button>
 <button class="tab" data-view="widgets">▦ Widgets</button>
 <button class="tab" data-view="active">In progress</button>
 <button class="tab" data-view="done">Completed</button>
 <button class="tab" data-view="calendar">Calendar</button>
 <button class="tab" data-view="weekly">Weekly overview</button>
 <button class="tab" data-view="focus">Focus room</button>
</nav>

<div class="toolbar">
 <div class="muted" id="viewLabel">Your notes</div>
 <div class="actions">
  <input class="search" id="search" placeholder="⌕ Search notes...">
  <select class="search" id="categoryFilter" aria-label="Filter category">
   <option value="all">All categories</option>
   <option>College</option><option>Personal</option>
   <option>Work</option><option>Projects</option>
  </select>
  <button class="primary" onclick="openEditor()">+ New note</button>
 </div>
</div>

<section id="mainView">
 <div class="notes-grid" id="notesGrid"></div>
</section>

<section class="panel" id="calendarPanel">
 <div class="calendar-head">
  <button class="secondary" onclick="changeMonth(-1)">‹</button>
  <h2 id="monthLabel"></h2>
  <button class="secondary" onclick="changeMonth(1)">›</button>
 </div>
 <div class="calendar-grid" id="calendarGrid"></div>
 <h3>Upcoming deadlines</h3>
 <div class="upcoming" id="upcoming"></div>
</section>

<section class="panel" id="weeklyPanel">
 <h2>Your week in review ✿</h2>
 <p class="muted">A little progress adds up.</p>
 <div class="stats">
  <div class="stat"><strong id="weeklyDone">0</strong><small>Tasks completed</small></div>
  <div class="stat"><strong id="weeklyNotes">0</strong><small>Notes created</small></div>
  <div class="stat"><strong id="weeklyTime">0m</strong><small>Focus time tracked</small></div>
 </div>
 <div id="weeklyList" class="upcoming"></div>
</section>

<section class="panel" id="focusPanel">
 <h2>Focus room ✿</h2>
 <p class="muted">Take one thing at a time. You've got this.</p>
 <div class="pomodoro">
  <div class="muted" id="pomoLabel">Focus session · 25 minutes</div>
  <div class="pomo-time" id="pomoDisplay">25:00</div>
  <div class="pomo-controls">
   <button class="primary" id="pomoStart" onclick="togglePomo()">Start focus</button>
   <button class="secondary" onclick="resetPomo()">Reset</button>
  </div>
  <div class="field" style="max-width:220px;margin:20px auto">
   <label>SESSION LENGTH (MINUTES)</label>
   <input type="number" id="pomoLength" min="1" max="120" value="25">
  </div>
 </div>
</section>

<section class="panel" id="settingsPanel">
 <h2>Make it yours ✿</h2>
 <div class="settings-grid">
  <div>
   <label>BACKGROUND COLOUR</label>
   <input type="color" id="bgPicker" value="#f5f4f0">
  </div>
  <div>
   <label>QUICK BACKGROUND THEMES</label>
   <div class="swatches">
    <button class="swatch" style="background:#f5f4f0" data-bg="#f5f4f0"></button>
    <button class="swatch" style="background:#eeeae2" data-bg="#eeeae2"></button>
    <button class="swatch" style="background:#eaf0e9" data-bg="#eaf0e9"></button>
    <button class="swatch" style="background:#f2e9eb" data-bg="#f2e9eb"></button>
    <button class="swatch" style="background:#e9edf2" data-bg="#e9edf2"></button>
    <button class="swatch" style="background:#eeeaf5" data-bg="#eeeaf5"></button>
   </div>
  </div>
  <div>
   <label>APPEARANCE</label>
   <button class="secondary" onclick="toggleDark()">Toggle dark mode</button>
  </div>
  <div>
   <label>NOTIFICATIONS</label>
   <button class="secondary" onclick="enableNotifications()">Enable reminders</button>
  </div>
 </div>
 <p class="muted">Your appearance preferences are saved in this browser.</p>
</section>
</div>

<!-- EDITOR -->
<div class="modal" id="editor">
<div class="modal-content">
 <h2 id="editorTitle">Create a note ✿</h2>
 <div class="field"><label>TITLE</label><input id="title" placeholder="What is on your mind?"></div>
 <div class="field"><label>DESCRIPTION</label><textarea id="description" placeholder="Write something..."></textarea></div>
 <div class="field"><label>CATEGORY</label>
  <select id="category"><option>College</option><option>Personal</option><option>Work</option><option>Projects</option></select>
 </div>
 <div class="field"><label>SUBTASKS</label>
  <div id="subtaskEditors"></div>
  <button class="secondary" onclick="addSubtask()">+ Add subtask</button>
 </div>
 <div class="field"><label>DUE DATE</label><input type="date" id="dueDate"></div>
 <div class="field"><label>REMINDER DATE & TIME</label><input type="datetime-local" id="reminder"></div>
 <div class="field"><label>ATTACH FILE</label><input type="file" id="fileInput"><small id="fileInfo" class="muted"></small></div>
 <div class="field"><label>WIDGET SIZE</label>
  <select id="size"><option value="normal">Medium</option><option value="small">Small</option><option value="large">Large</option></select>
 </div>
 <div class="field"><label>NOTE COLOUR</label>
  <div class="color-options">
   <button class="color-choice yellow selected" data-color="yellow"></button>
   <button class="color-choice pink" data-color="pink"></button>
   <button class="color-choice green" data-color="green"></button>
   <button class="color-choice blue" data-color="blue"></button>
   <button class="color-choice purple" data-color="purple"></button>
  </div>
 </div>
 <div class="modal-actions">
  <button class="secondary" onclick="closeEditor()">Cancel</button>
  <button class="primary" onclick="saveNote()">Save note</button>
 </div>
</div>
</div>

<script>
const $ = id => document.getElementById(id);
const KEY = 'notebloom_v2';
let notes = JSON.parse(localStorage.getItem(KEY)||'[]');
let view = 'all', editing = null, color = 'yellow';
let month = new Date().getMonth(), year = new Date().getFullYear();
let pomoSeconds = 25*60, pomoRunning = false, pomoEnd = null;
let pomoInterval = null;
let notified = new Set();

function persist(){
 try{localStorage.setItem(KEY,JSON.stringify(notes))}
 catch(e){alert('Storage is full. Remove large attachments and try again.')}
}
function escapeHTML(s=''){
 return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function todayKey(d=new Date()){
 return d.toISOString().slice(0,10);
}
function isDone(n){return n.tasks.length>0&&n.tasks.every(t=>t.done)}
function elapsed(n){return (n.elapsed||0)+(n.started?Math.floor((Date.now()-n.started)/1000):0)}
function timeFmt(s){
 s=Math.max(0,Math.floor(s));
 return [Math.floor(s/3600),Math.floor(s%3600/60),s%60].map(x=>String(x).padStart(2,'0')).join(':');
}
function formatDate(d){
 return new Date(d+'T00:00:00').toLocaleDateString('en-IN',{day:'numeric',month:'short'});
}
function openEditor(id=null){
 editing=id;
 let n=notes.find(x=>x.id===id);
 $('editorTitle').textContent=n?'Edit note ✿':'Create a note ✿';
 $('title').value=n?.title||'';
 $('description').value=n?.description||'';
 $('category').value=n?.category||'College';
 $('dueDate').value=n?.due||'';
 $('reminder').value=n?.reminder||'';
 $('size').value=n?.size||'normal';
 $('fileInput').value='';
 $('fileInfo').textContent=n?.file?'Current file: '+n.file.name:'';
 color=n?.color||'yellow';
 updateColors();
 $('subtaskEditors').innerHTML='';
 (n?.tasks||[]).forEach(t=>addSubtask(t.text));
 $('editor').classList.add('show');
}
function closeEditor(){$('editor').classList.remove('show')}
function addSubtask(value=''){
 let div=document.createElement('div');
 div.className='subtask-editor';
 let input=document.createElement('input');
 input.placeholder='Enter a task...';input.value=value;
 let del=document.createElement('button');
 del.textContent='×';del.onclick=()=>div.remove();
 div.append(input,del);$('subtaskEditors').append(div);
}
document.querySelectorAll('.color-choice').forEach(b=>b.onclick=()=>{
 color=b.dataset.color;updateColors();
});
function updateColors(){
 document.querySelectorAll('.color-choice').forEach(b=>b.classList.toggle('selected',b.dataset.color===color));
}
function fileToData(file){
 return new Promise((resolve,reject)=>{
  let r=new FileReader();
  r.onload=()=>resolve({name:file.name,data:r.result});
  r.onerror=reject;r.readAsDataURL(file);
 });
}
async function saveNote(){
 let title=$('title').value.trim();
 if(!title){alert('Please enter a title.');return}
 let old=notes.find(n=>n.id===editing);
 let tasks=[...document.querySelectorAll('.subtask-editor input')]
 .map(i=>i.value.trim()).filter(Boolean).map(text=>{
  let t=old?.tasks.find(t=>t.text===text);
  return {id:t?.id||crypto.randomUUID(),text,done:t?.done||false,doneAt:t?.doneAt||null};
 });
 let uploaded=$('fileInput').files[0];
 let file=uploaded?await fileToData(uploaded):(old?.file||null);
 let n={
  id:editing||crypto.randomUUID(),title,description:$('description').value,
  category:$('category').value,tasks,due:$('dueDate').value,
  reminder:$('reminder').value,color,size:$('size').value,file,
  elapsed:old?.elapsed||0,started:old?.started||null,
  pinned:old?.pinned||false,created:old?.created||Date.now()
 };
 if(old)notes=notes.map(x=>x.id===editing?n:x);else notes.unshift(n);
 persist();closeEditor();render();
}
function removeNote(id){
 if(!confirm('Delete this note?'))return;
 notes=notes.filter(n=>n.id!==id);persist();render();
}
function toggleTask(id,tid){
 let n=notes.find(x=>x.id===id),t=n.tasks.find(x=>x.id===tid);
 t.done=!t.done;t.doneAt=t.done?Date.now():null;
 persist();render();
}
function timer(id){
 let n=notes.find(x=>x.id===id);
 if(n.started){n.elapsed=elapsed(n);n.started=null}
 else n.started=Date.now();
 persist();render();
}
function resetTimer(id){
 let n=notes.find(x=>x.id===id);n.elapsed=0;n.started=null;
 persist();render();
}
function pin(id){
 let n=notes.find(x=>x.id===id);n.pinned=!n.pinned;
 persist();render();
}
function render(){
 let q=$('search').value.toLowerCase(),cat=$('categoryFilter').value;
 let filtered=notes.filter(n=>(n.title+' '+n.description).toLowerCase().includes(q)&&(cat==='all'||n.category===cat));
 if(view==='active')filtered=filtered.filter(n=>!isDone(n));
 if(view==='done')filtered=filtered.filter(isDone);
 if(view==='widgets')filtered=filtered.filter(n=>n.pinned);
 filtered.sort((a,b)=>Number(b.pinned)-Number(a.pinned));
 let total=notes.reduce((s,n)=>s+n.tasks.length,0);
 let done=notes.reduce((s,n)=>s+n.tasks.filter(t=>t.done).length,0);
 let weekAgo=Date.now()-7*86400000;
 let weekDone=notes.reduce((s,n)=>s+n.tasks.filter(t=>t.doneAt&&t.doneAt>=weekAgo).length,0);
 $('noteCount').textContent=notes.length;
 $('doneCount').textContent=done;
 $('pendingCount').textContent=total-done;
 $('weekCount').textContent=weekDone;
 $('mainView').style.display=['calendar','weekly','focus','settings'].includes(view)?'none':'block';
 ['calendar','weekly','focus','settings'].forEach(p=>$(p+'Panel').classList.toggle('show',view===p));
 $('viewLabel').textContent=({all:'Your notes',widgets:'Pinned widgets',active:'Notes in progress',done:'Completed notes',calendar:'Your calendar',weekly:'Weekly overview',focus:'Focus room',settings:'Appearance settings'})[view];
 $('categoryFilter').style.display=['calendar','weekly','focus','settings'].includes(view)?'none':'block';
 let grid=$('notesGrid');grid.className='notes-grid'+(view==='widgets'?' widgets':'');
 if(!filtered.length){
  grid.innerHTML='<div class="empty"><div>✿</div><h3>No notes found</h3><p>Create a note or pin one to your widgets.</p></div>';
 }else{
 grid.innerHTML=filtered.map(n=>{
  let count=n.tasks.length,done=n.tasks.filter(t=>t.done).length;
  let overdue=n.due&&n.due<todayKey()&&!isDone(n);
  return `<article class="note ${n.color} ${n.size} ${n.pinned?'pinned':''}" draggable="true" data-id="${n.id}">
   <div class="note-top"><span class="note-date">${escapeHTML(n.category)} · ${new Date(n.created).toLocaleDateString('en-IN')}</span>
   <div class="note-menu">
    <button class="icon-btn" title="Pin widget" onclick="pin('${n.id}')">${n.pinned?'★':'☆'}</button>
    <button class="icon-btn" title="Edit" onclick="openEditor('${n.id}')">✎</button>
    <button class="icon-btn" title="Delete" onclick="removeNote('${n.id}')">×</button>
   </div></div>
   <h3>${escapeHTML(n.title)}</h3><p>${escapeHTML(n.description)}</p>
   ${count?`<div class="task-list">${n.tasks.map(t=>`<div class="task"><label><input type="checkbox" ${t.done?'checked':''} onchange="toggleTask('${n.id}','${t.id}')"><span class="${t.done?'done':''}">${escapeHTML(t.text)}</span></label></div>`).join('')}</div>
   <div class="progress"><div style="width:${done/count*100}%"></div></div><small>${done}/${count} completed</small>`:''}
   <div class="note-footer"><div>
    ${n.due?`<span style="color:${overdue?'#b64d4d':'inherit'}">${overdue?'⚠ Overdue':'◷ Due'} ${formatDate(n.due)}</span>`:''}
    ${n.file?`<a class="file-link" href="${n.file.data}" download="${escapeHTML(n.file.name)}">↗ ${escapeHTML(n.file.name)}</a>`:''}
   </div><div class="note-tools"><div class="timer-box">
    <span class="timer-display" id="timer-${n.id}">${timeFmt(elapsed(n))}</span>
    <button onclick="timer('${n.id}')">${n.started?'Ⅱ':'▶'}</button>
    <button onclick="resetTimer('${n.id}')">↺</button>
   </div></div></div>
  </article>`;
 }).join('');
 addDragEvents();
 }
 if(view==='calendar')renderCalendar();
 if(view==='weekly')renderWeekly();
}
function addDragEvents(){
 let dragging=null;
 document.querySelectorAll('.note').forEach(card=>{
  card.addEventListener('dragstart',()=>{dragging=card;card.classList.add('dragging')});
  card.addEventListener('dragend',()=>card.classList.remove('dragging'));
  card.addEventListener('dragover',e=>e.preventDefault());
  card.addEventListener('drop',e=>{
   e.preventDefault();
   if(!dragging||dragging===card)return;
   let ids=[...$('notesGrid').children].map(x=>x.dataset.id);
   let from=ids.indexOf(dragging.dataset.id),to=ids.indexOf(card.dataset.id);
   let moved=notes.find(n=>n.id===ids[from]);
   let target=notes.find(n=>n.id===ids[to]);
   notes.splice(notes.indexOf(moved),1);
   notes.splice(notes.indexOf(target),0,moved);
   persist();render();
  });
 });
}
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{
 view=b.dataset.view;
 document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===b));
 render();
});
$('search').oninput=render;$('categoryFilter').onchange=render;

// Calendar
function changeMonth(delta){
 month+=delta;
 if(month>11){month=0;year++}if(month<0){month=11;year--}
 renderCalendar();
}
function renderCalendar(){
 let first=new Date(year,month,1).getDay();
 let days=new Date(year,month+1,0).getDate();
 $('monthLabel').textContent=new Date(year,month,1).toLocaleDateString('en-IN',{month:'long',year:'numeric'});
 let html=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(d=>`<div class="muted">${d}</div>`).join('');
 for(let i=0;i<first;i++)html+='<div></div>';
 for(let d=1;d<=days;d++){
  let key=todayKey(new Date(year,month,d));
  let due=notes.filter(n=>n.due===key);
  html+=`<div class="calendar-cell ${key===todayKey()?'today':''}">${d}${due.map(n=>`<small>• ${escapeHTML(n.title)}</small>`).join('')}</div>`;
 }
 $('calendarGrid').innerHTML=html;
 let upcoming=notes.filter(n=>n.due&&n.due>=todayKey()).sort((a,b)=>a.due.localeCompare(b.due));
 $('upcoming').innerHTML=upcoming.length?upcoming.map(n=>`<div class="upcoming-item">${escapeHTML(n.title)} <span class="muted">— ${formatDate(n.due)}</span></div>`).join(''):'<p class="muted">No upcoming deadlines.</p>';
}
function renderWeekly(){
 let start=Date.now()-7*86400000;
 let completed=notes.flatMap(n=>n.tasks).filter(t=>t.doneAt&&t.doneAt>=start);
 let created=notes.filter(n=>n.created>=start);
 let seconds=notes.reduce((s,n)=>s+elapsed(n),0);
 $('weeklyDone').textContent=completed.length;
 $('weeklyNotes').textContent=created.length;
 $('weeklyTime').textContent=Math.floor(seconds/60)+'m';
 $('weeklyList').innerHTML=completed.length?completed.map(t=>`<div class="upcoming-item">✓ ${escapeHTML(t.text)}</div>`).join(''):'<p class="muted">Your completed tasks will appear here.</p>';
}

// Pomodoro
function updatePomo(){
 let left=pomoEnd?Math.max(0,Math.ceil((pomoEnd-Date.now())/1000)):pomoSeconds;
 $('pomoDisplay').textContent=String(Math.floor(left/60)).padStart(2,'0')+':'+String(left%60).padStart(2,'0');
 if(left<=0&&pomoRunning){
  pomoRunning=false;pomoEnd=null;clearInterval(pomoInterval);
  $('pomoStart').textContent='Start focus';
  $('pomoLabel').textContent='Session complete ✿ Take a break!';
  if('Notification'in window&&Notification.permission==='granted')new Notification('NoteBloom',{body:'Your focus session is complete!'});
  pomoSeconds=Number($('pomoLength').value)*60;
 }
}
function togglePomo(){
 if(pomoRunning){
  pomoSeconds=Math.max(0,Math.ceil((pomoEnd-Date.now())/1000));
  pomoRunning=false;pomoEnd=null;clearInterval(pomoInterval);
  $('pomoStart').textContent='Resume focus';
 }else{
  pomoRunning=true;pomoEnd=Date.now()+pomoSeconds*1000;
  $('pomoStart').textContent='Pause';
  pomoInterval=setInterval(updatePomo,250);
 }
 updatePomo();
}
function resetPomo(){
 pomoRunning=false;pomoEnd=null;clearInterval(pomoInterval);
 pomoSeconds=Number($('pomoLength').value)*60;
 $('pomoStart').textContent='Start focus';
 $('pomoLabel').textContent='Focus session · '+$('pomoLength').value+' minutes';
 updatePomo();
}
$('pomoLength').onchange=resetPomo;

// Appearance
function setBackground(c){
 document.documentElement.style.setProperty('--bg',c);
 $('bgPicker').value=c;
 localStorage.setItem('notebloom_bg',c);
}
$('bgPicker').oninput=e=>setBackground(e.target.value);
document.querySelectorAll('[data-bg]').forEach(b=>b.onclick=()=>setBackground(b.dataset.bg));
function toggleDark(){
 document.body.classList.toggle('dark');
 localStorage.setItem('notebloom_dark',document.body.classList.contains('dark'));
}
function showPanel(name){
 view=name;
 document.querySelectorAll('.tab').forEach(b=>b.classList.remove('active'));
 render();
}
function enableNotifications(){
 if('Notification'in window)Notification.requestPermission().then(p=>alert('Notification permission: '+p));
 else alert('Notifications are not supported in this browser.');
}
function checkReminders(){
 if(!('Notification'in window)||Notification.permission!=='granted')return;
 notes.forEach(n=>{
  if(!n.reminder)return;
  let key=n.id+n.reminder;
  if(Date.now()>=new Date(n.reminder).getTime()&&!notified.has(key)){
   notified.add(key);
   new Notification('NoteBloom reminder ✿',{body:n.title});
  }
 });
}
setInterval(()=>{
 notes.forEach(n=>{
  if(n.started){
   let el=$('timer-'+n.id);if(el)el.textContent=timeFmt(elapsed(n));
  }
 });
 checkReminders();
},1000);

// Restore preferences
let savedBg=localStorage.getItem('notebloom_bg');
if(savedBg)setBackground(savedBg);
if(localStorage.getItem('notebloom_dark')==='true')document.body.classList.add('dark');
render();updatePomo();
</script>
